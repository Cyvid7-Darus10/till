# Till reads its settings from these variables. None of them are secrets.
# On Vercel, set them in Project Settings > Environment Variables.
# Locally, `vercel env pull .env.local` brings them down along with the OIDC token Vercel Connect needs.

# Required
TILL_KMS_ISSUER_ID=00000000-0000-4000-8000-000000000000   # Team Settings > Key Management > your issuer
TILL_FINANCE_ADMIN_SLACK_IDS=U0123ABCD,U0456EFGH          # who may create invoices (Slack profile > Copy member ID)

# Optional (defaults shown)
# TILL_ALLOWED_CHANNEL_IDS=C0123ABCD                    # only answer here (empty: any channel Till is in)
# TILL_COMPANY_NAME=the company
# TILL_SLACK_CONNECTOR=slack/till
# TILL_AIRWALLEX_CONNECTOR=airwallex/till-sandbox
# TILL_TEAM_LOGIN_ID=finance-team
# TILL_LOGIN_LINK_TTL_SECONDS=900
# TILL_MODEL=openai/gpt-5
# TILL_MODEL_REASONING_EFFORT=low
# TILL_THREAD_HISTORY_LIMIT=30
